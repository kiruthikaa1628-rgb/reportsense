# Copy this file to ".env" for local use. On Vercel, add the same names in
# Project > Settings > Environment Variables.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase > Connect > Transaction pooler connection string (replace [YOUR-PASSWORD])
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_ID:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
# https://aistudio.google.com/app/apikey  (keep secret, never put VITE_ in front of it)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the Gemini model if Google renames it
# GEMINI_MODEL=gemini-2.5-flash
